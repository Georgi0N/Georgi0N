    // =========================================================

    private String extractString(String json, String key) {
        Pattern p = Pattern.compile("\"" + Pattern.quote(key) + "\"\\s*:\\s*\"([^\"]*)\"");
        Matcher m = p.matcher(json);
        return m.find() ? m.group(1) : null;
    }

    private double extractDouble(String json, String key) {
        Pattern p = Pattern.compile("\"" + Pattern.quote(key) + "\"\\s*:\\s*(-?\\d+(?:\\.\\d+)?)");
        Matcher m = p.matcher(json);
        return m.find() ? Double.parseDouble(m.group(1)) : 0;
    }

    private double extractDoubleFromObject(String json, String objectName, String key) {
        String object = extractObject(json, objectName);
        return extractDouble(object, key);
    }

    private List<String> extractStringArrayFromObject(String json, String objectName, String key) {
        String object = extractObject(json, objectName);
        String array = extractArrayRaw(object, key);
        List<String> list = new ArrayList<>();
        Matcher m = Pattern.compile("\"([^\"]*)\"").matcher(array);
        while (m.find()) list.add(m.group(1));
        return list;
    }

    private List<Double> extractNumberArrayFromObject(String json, String objectName, String key) {
        String object = extractObject(json, objectName);
        String array = extractArrayRaw(object, key);
        List<Double> list = new ArrayList<>();
        Matcher m = Pattern.compile("-?\\d+(?:\\.\\d+)?").matcher(array);
        while (m.find()) list.add(Double.parseDouble(m.group()));
        return list;
    }

    private String extractObject(String json, String objectName) {
        Pattern p = Pattern.compile("\"" + Pattern.quote(objectName) + "\"\\s*:\\s*\\{", Pattern.DOTALL);
        Matcher m = p.matcher(json);
        if (!m.find()) return "";
        int start = m.end() - 1;
        return extractBalanced(json, start, '{', '}');
    }

    private String extractArrayRaw(String json, String key) {
        Pattern p = Pattern.compile("\"" + Pattern.quote(key) + "\"\\s*:\\s*\\[", Pattern.DOTALL);
        Matcher m = p.matcher(json);
        if (!m.find()) return "";
        int start = m.end() - 1;
        return extractBalanced(json, start, '[', ']');
    }

    private String extractBalanced(String text, int start, char open, char close) {
        int level = 0;
        for (int i = start; i < text.length(); i++) {
            char c = text.charAt(i);
            if (c == open) level++;
            if (c == close) level--;
            if (level == 0) return text.substring(start, i + 1);
        }
        return "";
    }

    private String extractFirstResultObject(String json) {
        String resultsArray = extractArrayRaw(json, "results");
        if (resultsArray.isEmpty()) return "";
        List<String> objects = splitTopLevelObjects(resultsArray);
        return objects.isEmpty() ? "" : objects.get(0);
    }

    private List<String> splitTopLevelObjects(String arrayText) {
        List<String> objects = new ArrayList<>();
        int level = 0;
        int start = -1;

        for (int i = 0; i < arrayText.length(); i++) {
            char c = arrayText.charAt(i);

            if (c == '{') {
                if (level == 0) start = i;
                level++;
            } else if (c == '}') {
                level--;
                if (level == 0 && start != -1) {
                    objects.add(arrayText.substring(start, i + 1));
                    start = -1;
                }
            }
        }

        return objects;
    }

    private String shortTime(String isoDateTime) {
        if (isoDateTime == null || !isoDateTime.contains("T")) return isoDateTime;
        return isoDateTime.substring(isoDateTime.indexOf('T') + 1);
    }

    private String shortHour(String isoDateTime) {
        if (isoDateTime == null || !isoDateTime.contains("T")) return isoDateTime;
        String hourPart = isoDateTime.substring(isoDateTime.indexOf('T') + 1);
        return hourPart.length() >= 5 ? hourPart.substring(0, 5) : hourPart;
    }

    private String shortDay(String yyyyMmDd) {
        try {
            LocalDate d = LocalDate.parse(yyyyMmDd);
            String s = d.getDayOfWeek().toString();
            return s.substring(0, 1) + s.substring(1, 3).toLowerCase(Locale.ROOT);
        } catch (Exception e) {
            return yyyyMmDd;
        }
    }

