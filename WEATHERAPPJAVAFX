    private VBox createDashboardLeftSidebar() {
        VBox box = glassBox(280);
        box.setSpacing(14);
        box.setAlignment(Pos.TOP_CENTER);
        box.setFillWidth(true);

        Label title = new Label("SkyCast X");
        title.setFont(Font.font("Arial", FontWeight.EXTRA_BOLD, 28));
        title.setTextFill(Color.WHITE);

        Label subtitle = new Label("Real API Weather • Autocomplete");
        subtitle.setTextFill(Color.web("#dbeafe"));

        searchField = new TextField();
        searchField.setPromptText("Type city name...");
        styleTextField(searchField);
        searchField.setMaxWidth(Double.MAX_VALUE);

        suggestionsList = new ListView<>(suggestionItems);
        suggestionsList.setPrefHeight(150);
        suggestionsList.setMaxHeight(150);
        suggestionsList.setMaxWidth(Double.MAX_VALUE);
        suggestionsList.setStyle(
                "-fx-background-color: rgba(15,23,42,0.70);" +
                        "-fx-control-inner-background: rgba(15,23,42,0.85);" +
                        "-fx-background-radius: 14;" +
                        "-fx-border-radius: 14;" +
                        "-fx-border-color: rgba(255,255,255,0.18);" +
                        "-fx-text-fill: white;"
        );
        suggestionsList.setVisible(false);
        suggestionsList.setManaged(false);

        suggestionsList.setOnMouseClicked(e -> {
            String selected = suggestionsList.getSelectionModel().getSelectedItem();
            if (selected != null) {
                String city = selected.contains(" | ") ? selected.substring(0, selected.indexOf(" | ")) : selected;
                searchField.setText(city);
                hideSuggestions();
                fetchWeatherForCity(city);
            }
        });

        searchField.textProperty().addListener((obs, oldValue, newValue) -> {
            if (newValue == null || newValue.trim().length() < 2) {
                hideSuggestions();
            } else {
                fetchSuggestions(newValue.trim());
            }
        });

        searchField.setOnKeyPressed(e -> {
            if (e.getCode() == KeyCode.DOWN && suggestionsList.isVisible()) {
                suggestionsList.requestFocus();
                suggestionsList.getSelectionModel().selectFirst();
            }
            if (e.getCode() == KeyCode.ENTER) {
                if (suggestionsList.isVisible() && suggestionsList.getSelectionModel().getSelectedItem() != null) {
                    String selected = suggestionsList.getSelectionModel().getSelectedItem();
                    String city = selected.contains(" | ") ? selected.substring(0, selected.indexOf(" | ")) : selected;
                    searchField.setText(city);
                    hideSuggestions();
                    fetchWeatherForCity(city);
                } else {
                    fetchWeatherForSearch();
                }
            }
        });

        suggestionsList.setOnKeyPressed(e -> {
            if (e.getCode() == KeyCode.ENTER) {
                String selected = suggestionsList.getSelectionModel().getSelectedItem();
                if (selected != null) {
                    String city = selected.contains(" | ") ? selected.substring(0, selected.indexOf(" | ")) : selected;
                    searchField.setText(city);
                    hideSuggestions();
                    fetchWeatherForCity(city);
                }
            }
        });

        searchBtn = modernButton("Search City");
        searchBtn.setOnAction(e -> fetchWeatherForSearch());

        Button beirutBtn = modernButton("Beirut");
        beirutBtn.setOnAction(e -> fetchWeatherForCity("Beirut"));

        Button parisBtn = modernButton("Paris");
        parisBtn.setOnAction(e -> fetchWeatherForCity("Paris"));

        Button tokyoBtn = modernButton("Tokyo");
        tokyoBtn.setOnAction(e -> fetchWeatherForCity("Tokyo"));

        Button londonBtn = modernButton("London");
        londonBtn.setOnAction(e -> fetchWeatherForCity("London"));

        Button addFavoriteBtn = modernButton("Add to Favorites");
        addFavoriteBtn.setOnAction(e -> addCurrentCityToFavorites());

        Button refreshBtn = modernButton("Refresh Weather");
        refreshBtn.setOnAction(e -> {
            if (!currentCityQuery.isBlank()) fetchWeatherForCity(currentCityQuery);
        });

        Button detailsBtn = modernButton("Open Details Scene");
        detailsBtn.setOnAction(e -> switchScene(detailsScene));

        Button favoritesBtn = modernButton("Favorites Scene");
        favoritesBtn.setOnAction(e -> {
            refreshFavoritesScene();
            switchScene(favoritesScene);
        });

        Button splashBtn = modernButton("Back to Splash");
        splashBtn.setOnAction(e -> switchScene(splashScene));

        makeButtonFullWidth(searchBtn);
        makeButtonFullWidth(beirutBtn);
        makeButtonFullWidth(parisBtn);
        makeButtonFullWidth(tokyoBtn);
        makeButtonFullWidth(londonBtn);
        makeButtonFullWidth(addFavoriteBtn);
        makeButtonFullWidth(refreshBtn);
        makeButtonFullWidth(detailsBtn);
        makeButtonFullWidth(favoritesBtn);
        makeButtonFullWidth(splashBtn);

        statusLabel = new Label("Ready");
        statusLabel.setWrapText(true);
        statusLabel.setTextFill(Color.web("#fde68a"));
        statusLabel.setFont(Font.font("Arial", 13));

        Label attribution = new Label("Weather data: Open-Meteo");
        attribution.setTextFill(Color.web("#bfdbfe"));
        attribution.setFont(Font.font("Arial", 12));

        box.getChildren().addAll(
                title, subtitle,
                searchField, suggestionsList, searchBtn,
                beirutBtn, parisBtn, tokyoBtn, londonBtn,
                addFavoriteBtn, refreshBtn,
                detailsBtn, favoritesBtn, splashBtn,
                statusLabel, attribution
        );

        return box;
    }

