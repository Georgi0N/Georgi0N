        BorderPane.setMargin(left, new Insets(0, 15, 0, 0));
        BorderPane.setMargin(center, new Insets(0, 15, 0, 15));
        BorderPane.setMargin(right, new Insets(0, 0, 0, 15));

        loadingOverlay = createLoadingOverlay();

        updateSceneBackground(dashboardRoot, dashboardLayout, "clear sky", SceneType.DASHBOARD);
        dashboardRoot.getChildren().add(loadingOverlay);

        Scene scene = new Scene(dashboardRoot, 1450, 900);
        scene.setOnKeyPressed(e -> {
            if (e.getCode() == KeyCode.F1) switchScene(detailsScene);
            if (e.getCode() == KeyCode.F2) switchScene(favoritesScene);
