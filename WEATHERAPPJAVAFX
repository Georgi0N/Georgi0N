    private Scene createSplashScene() {
        StackPane root = new StackPane();
        root.setBackground(new Background(new BackgroundFill(
                new LinearGradient(
                        0, 0, 1, 1, true, CycleMethod.NO_CYCLE,
                        new Stop(0, Color.web("#020617")),
                        new Stop(0.5, Color.web("#1e3a8a")),
                        new Stop(1, Color.web("#312e81"))
                ),
                CornerRadii.EMPTY,
                Insets.EMPTY
        )));

        Circle glow1 = new Circle(170, Color.rgb(255, 255, 255, 0.08));
        Circle glow2 = new Circle(230, Color.rgb(255, 255, 255, 0.05));
        glow1.setTranslateX(-300);
        glow1.setTranslateY(-180);
        glow2.setTranslateX(300);
        glow2.setTranslateY(180);

        VBox box = new VBox(18);
        box.setAlignment(Pos.CENTER);

        Label title = new Label("SkyCast X Ultimate");
        title.setFont(Font.font("Arial", FontWeight.EXTRA_BOLD, 42));
        title.setTextFill(Color.WHITE);

        Label subtitle = new Label("Connecting to satellite weather network...");
        subtitle.setFont(Font.font("Arial", 18));
        subtitle.setTextFill(Color.web("#dbeafe"));

        Label tiny = new Label("Version 3 • Multi Scene • Real API • Autocomplete");
        tiny.setFont(Font.font("Arial", 13));
        tiny.setTextFill(Color.web("#93c5fd"));

        ProgressBar bar = new ProgressBar();
        bar.setPrefWidth(300);
        bar.setProgress(ProgressBar.INDETERMINATE_PROGRESS);

        Button enterBtn = modernButton("Enter Dashboard");
        enterBtn.setOnAction(e -> {
            switchScene(dashboardScene);
            if (currentWeatherData == null) {
                fetchWeatherForCity("Beirut");
            }
        });

        box.getChildren().addAll(title, subtitle, tiny, bar, enterBtn);

        root.getChildren().addAll(glow1, glow2, box);

        TranslateTransition t1 = new TranslateTransition(Duration.seconds(7), glow1);
        t1.setFromX(-300);
        t1.setToX(-200);
        t1.setAutoReverse(true);
        t1.setCycleCount(Animation.INDEFINITE);

        TranslateTransition t2 = new TranslateTransition(Duration.seconds(8), glow2);
        t2.setFromX(300);
        t2.setToX(200);
        t2.setAutoReverse(true);
        t2.setCycleCount(Animation.INDEFINITE);

        FadeTransition fade = new FadeTransition(Duration.seconds(1.8), box);
        fade.setFromValue(0.3);
        fade.setToValue(1);
        fade.setAutoReverse(true);
        fade.setCycleCount(Animation.INDEFINITE);

        t1.play();
        t2.play();
        fade.play();

        return new Scene(root, 1450, 900);
    }

    private Scene createDashboardScene() {
