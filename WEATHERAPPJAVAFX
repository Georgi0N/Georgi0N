    private void addHoverEffect(Region node) {
        ScaleTransition in = new ScaleTransition(Duration.millis(150), node);
        in.setToX(1.04);
        in.setToY(1.04);

        ScaleTransition out = new ScaleTransition(Duration.millis(150), node);
        out.setToX(1.0);
        out.setToY(1.0);

        node.setOnMouseEntered(e -> in.playFromStart());
        node.setOnMouseExited(e -> out.playFromStart());
    }

