    private void updateConditionColor(String condition) {
        if (conditionLabel == null || detailsConditionLabel == null) return;

        Color color;
        switch (condition.toLowerCase(Locale.ROOT)) {
            case "clear sky", "mainly clear" -> color = Color.web("#fde68a");
            case "partly cloudy", "overcast", "cloudy", "foggy" -> color = Color.web("#e5e7eb");
            case "rainy", "showers" -> color = Color.web("#93c5fd");
            case "stormy" -> color = Color.web("#c4b5fd");
            case "snowy" -> color = Color.web("#e0f2fe");
            default -> color = Color.WHITE;
        }

        conditionLabel.setTextFill(color);
        detailsConditionLabel.setTextFill(color);
    }

