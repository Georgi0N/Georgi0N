    private void startClock() {
        clockTimeline = new Timeline(
                new KeyFrame(Duration.seconds(0), e -> {
                    String time = "Local Time: " + LocalTime.now().format(DateTimeFormatter.ofPattern("hh:mm:ss a"));
                    if (timeLabel != null) timeLabel.setText(time);

                    if (currentWeatherData != null && sunProgressBar != null) {
                        sunProgressBar.setProgress(calculateDayProgress(currentWeatherData.sunrise, currentWeatherData.sunset));
                    }
                }),
                new KeyFrame(Duration.seconds(1))
        );
        clockTimeline.setCycleCount(Animation.INDEFINITE);
        clockTimeline.play();
    }

    private double calculateDayProgress(String sunrise, String sunset) {
        try {
            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("H:mm");
            LocalTime rise = LocalTime.parse(sunrise, formatter);
            LocalTime set = LocalTime.parse(sunset, formatter);
            LocalTime now = LocalTime.now();

            if (now.isBefore(rise)) return 0;
            if (now.isAfter(set)) return 1;

            long total = java.time.Duration.between(rise, set).toMinutes();
            long current = java.time.Duration.between(rise, now).toMinutes();
            return total == 0 ? 0 : (double) current / total;
        } catch (Exception e) {
            return 0.5;
        }
    }

