    // ===== AUTOCOMPLETE =====

    private void fetchSuggestions(String q) {
        new Thread(() -> { 
        // thread la ma ylag UI

            try {
                String url = "https://geocoding-api.open-meteo.com/v1/search?name="
                        + URLEncoder.encode(q, StandardCharsets.UTF_8); 

                String json = client.send(
                        HttpRequest.newBuilder().uri(URI.create(url)).build(),
                        HttpResponse.BodyHandlers.ofString()
                ).body(); 

                List<String> list = new ArrayList<>(); 

                Matcher m = Pattern.compile("\"name\":\"(.*?)\".*?\"country\":\"(.*?)\"")
                        .matcher(json); 

                while (m.find()) {
                    String value = m.group(1) + ", " + m.group(2); 
                    if (!list.contains(value)) list.add(value); 
                }

                Platform.runLater(() -> showSuggestions(list)); 

            } catch (Exception e) {
                e.printStackTrace(); 
            }

        }).start();
    }

    private void showSuggestions(List<String> list) {
        VBox box = new VBox(5); 

        for (int i = 0; i < Math.min(5, list.size()); i++) {

            String s = list.get(i); 

            Label item = new Label(s); 

            item.setOnMouseClicked(e -> {
                search.setText(s); 
                overlayLayer.getChildren().clear(); 
                fetchWeather(s); 
            });

            box.getChildren().add(item); 
        }

        overlayLayer.getChildren().setAll(box); 
    }

    // ===== WEATHER =====

    private void fetchWeather(String cityName) {
        new Thread(() -> {

            try {
                currentCity = cityName; 

                String geo = "https://geocoding-api.open-meteo.com/v1/search?name="
                        + URLEncoder.encode(cityName, StandardCharsets.UTF_8); 

                String geoJson = client.send(
                        HttpRequest.newBuilder().uri(URI.create(geo)).build(),
                        HttpResponse.BodyHandlers.ofString()
                ).body(); 

                double lat = extract(geoJson, "latitude"); 
                double lon = extract(geoJson, "longitude"); 

                lastLat = lat; 
                lastLon = lon; 

                String api = "https://api.open-meteo.com/v1/forecast?latitude=" + lat +
                        "&longitude=" + lon +
                        "&current=temperature_2m,weather_code,relative_humidity_2m,wind_speed_10m,surface_pressure,visibility" +
                        "&timezone=auto";

                String json = client.send(
                        HttpRequest.newBuilder().uri(URI.create(api)).build(),
                        HttpResponse.BodyHandlers.ofString()
                ).body(); 

                Platform.runLater(() -> updateUI(cityName, json)); 

            } catch (Exception e) {
                e.printStackTrace(); 
            }

        }).start();
    }

    private void updateUI(String name, String json) {

        double t = extract(json, "temperature_2m"); 
        int code = (int) extract(json, "weather_code"); 

        currentTempC = t; 

        city.setText(name); 

        if (isCelsius)
            temp.setText(String.format("%.1f°C", t)); 
        else
            temp.setText(String.format("%.1f°F", (t * 9 / 5) + 32)); 

        condition.setText(text(code)); 
        icon.setText(icon(code)); 

        humidity.setText((int) extract(json, "relative_humidity_2m") + "%"); 
        wind.setText(String.format("%.1f km/h", extract(json, "wind_speed_10m"))); 
        pressure.setText(String.format("%.0f hPa", extract(json, "surface_pressure"))); 
        visibility.setText(String.format("%.1f km", extract(json, "visibility") / 1000)); 
    }

    // ===== HELPERS =====

    private double extract(String json, String key) {
        Matcher m = Pattern.compile("\"" + key + "\":\\s*(-?\\d+(\\.\\d+)?)")
                .matcher(json);

        if (m.find()) return Double.parseDouble(m.group(1)); 

        return 0; 
    }

    private String text(int c) {
        if (c == 0) return "Clear Sky"; 
        if (c <= 3) return "Cloudy"; 
        if (c < 70) return "Rainy"; 
        return "Stormy"; 
    }

    private String icon(int c) {
        if (c == 0) return "☀"; 
        if (c <= 3) return "☁"; 
        if (c < 70) return "🌧"; 
        return "⛈"; 
    }

    public static void main(String[] args) {
