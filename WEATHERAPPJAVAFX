    private void updateSceneBackground(StackPane root, BorderPane content, String condition, SceneType sceneType) {
        if (root == null || content == null) return;

        Color[] colors = getBackgroundColors(condition);

        StackPane bg = new StackPane();
        bg.setBackground(new Background(new BackgroundFill(
                new LinearGradient(
                        0, 0, 1, 1, true, CycleMethod.NO_CYCLE,
                        new Stop(0, colors[0]),
                        new Stop(0.5, colors[1]),
                        new Stop(1, colors[2])
                ),
                CornerRadii.EMPTY,
                Insets.EMPTY
        )));

        Circle glow1 = new Circle(170, Color.rgb(255, 255, 255, 0.08));
        Circle glow2 = new Circle(220, Color.rgb(255, 255, 255, 0.06));
        glow1.setTranslateX(-320);
        glow1.setTranslateY(-170);
        glow2.setTranslateX(280);
        glow2.setTranslateY(180);

        bg.getChildren().addAll(glow1, glow2);

        root.getChildren().setAll(bg, content);

        switch (sceneType) {
            case DASHBOARD -> {
                dashboardGlow1 = glow1;
                dashboardGlow2 = glow2;
                animateGlowCircles(dashboardGlow1, dashboardGlow2);
            }
            case DETAILS -> {
                detailsGlow1 = glow1;
                detailsGlow2 = glow2;
                animateGlowCircles(detailsGlow1, detailsGlow2);
            }
            case FAVORITES -> {
                favoritesGlow1 = glow1;
                favoritesGlow2 = glow2;
                animateGlowCircles(favoritesGlow1, favoritesGlow2);
            }
        }
    }

    private Color[] getBackgroundColors(String condition) {
        Color c1;
        Color c2;
        Color c3;

        switch (condition) {
            case "clear sky", "mainly clear" -> {
                c1 = darkMode ? Color.web("#0f172a") : Color.web("#dbeafe");
                c2 = darkMode ? Color.web("#1d4ed8") : Color.web("#93c5fd");
                c3 = darkMode ? Color.web("#f59e0b") : Color.web("#fde68a");
            }
            case "partly cloudy", "cloudy", "overcast", "foggy" -> {
                c1 = darkMode ? Color.web("#111827") : Color.web("#e5e7eb");
                c2 = darkMode ? Color.web("#374151") : Color.web("#cbd5e1");
                c3 = darkMode ? Color.web("#64748b") : Color.web("#94a3b8");
            }
            case "rainy", "showers" -> {
                c1 = darkMode ? Color.web("#082f49") : Color.web("#dbeafe");
                c2 = darkMode ? Color.web("#0f766e") : Color.web("#7dd3fc");
                c3 = darkMode ? Color.web("#1d4ed8") : Color.web("#60a5fa");
            }
            case "stormy" -> {
                c1 = darkMode ? Color.web("#020617") : Color.web("#e2e8f0");
                c2 = darkMode ? Color.web("#312e81") : Color.web("#a5b4fc");
                c3 = darkMode ? Color.web("#7c3aed") : Color.web("#c4b5fd");
            }
            case "snowy" -> {
                c1 = darkMode ? Color.web("#0f172a") : Color.web("#eff6ff");
                c2 = darkMode ? Color.web("#334155") : Color.web("#bfdbfe");
                c3 = darkMode ? Color.web("#94a3b8") : Color.web("#f8fafc");
            }
            default -> {
                c1 = darkMode ? Color.web("#0f172a") : Color.web("#dbeafe");
                c2 = darkMode ? Color.web("#1e3a8a") : Color.web("#93c5fd");
                c3 = darkMode ? Color.web("#312e81") : Color.web("#c4b5fd");
            }
        }

        return new Color[]{c1, c2, c3};
    }

    private void animateGlowCircles(Circle glow1, Circle glow2) {
        if (glow1 == null || glow2 == null) return;

        TranslateTransition t1 = new TranslateTransition(Duration.seconds(7), glow1);
        t1.setFromX(-320);
        t1.setToX(-220);
        t1.setAutoReverse(true);
        t1.setCycleCount(Animation.INDEFINITE);

        TranslateTransition t2 = new TranslateTransition(Duration.seconds(8), glow2);
        t2.setFromX(280);
        t2.setToX(200);
        t2.setAutoReverse(true);
        t2.setCycleCount(Animation.INDEFINITE);

        t1.play();
        t2.play();
    }

