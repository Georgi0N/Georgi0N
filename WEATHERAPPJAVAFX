    private void addToHistory(String cityDisplay) {
        if (historySet.add(cityDisplay)) {
            historyItems.add(0, cityDisplay);
            while (historyItems.size() > 8) {
                historyItems.remove(historyItems.size() - 1);
            }
        } else {
            historyItems.remove(cityDisplay);
            historyItems.add(0, cityDisplay);
        }
        refreshFavoritesScene();
    }

    private void refreshFavoritesScene() {
        if (favoritesCitiesBox == null || historyBox == null) return;

        favoritesCitiesBox.getChildren().clear();
        historyBox.getChildren().clear();

        if (favoritesItems.isEmpty()) {
            Label empty = new Label("No favorite cities yet.");
            empty.setTextFill(Color.web("#dbeafe"));
            favoritesCitiesBox.getChildren().add(empty);
        } else {
            for (String city : favoritesItems) {
                favoritesCitiesBox.getChildren().add(createCityActionCard(city, true));
            }
        }

        if (historyItems.isEmpty()) {
            Label empty = new Label("No search history yet.");
            empty.setTextFill(Color.web("#dbeafe"));
            historyBox.getChildren().add(empty);
        } else {
            for (String city : historyItems) {
                historyBox.getChildren().add(createHistoryCard(city));
            }
        }
    }

