    private void fetchWeatherForSearch() {
        String city = searchField.getText().trim();
        if (city.isEmpty()) return;
        hideSuggestions();
        fetchWeatherForCity(city);
    }

    private void fetchSuggestions(String query) {
        Thread thread = new Thread(() -> {
            try {
                List<String> suggestions = geocodeSuggestions(query);
                Platform.runLater(() -> showSuggestions(suggestions));
            } catch (Exception e) {
                Platform.runLater(this::hideSuggestions);
            }
        });
        thread.setDaemon(true);
        thread.start();
    }

    private void fetchWeatherForCity(String city) {
        currentCityQuery = city;
        setLoadingState(true, "Searching city and fetching live weather...");

        Thread thread = new Thread(() -> {
            try {
                GeoLocation location = geocodeCity(city);
                if (location == null) {
                    Platform.runLater(() -> {
                        setLoadingState(false, "City not found.");
                        showInfo("City Not Found", "The city could not be found.");
                    });
                    return;
                }

                WeatherResponse data = fetchWeather(location);

                Platform.runLater(() -> {
                    currentWeatherData = data;
                    updateUIFromWeather(data);
                    addToHistory(data.cityDisplay);
                    setLoadingState(false, "Live weather loaded for " + data.cityDisplay);
                    searchField.clear();
                    hideSuggestions();
                });

            } catch (Exception ex) {
                Platform.runLater(() -> {
                    setLoadingState(false, "Error loading data.");
                    showInfo("API Error", "Could not load weather.\n\n" + ex.getMessage());
                });
            }
        });

        thread.setDaemon(true);
        thread.start();
    }

    private GeoLocation geocodeCity(String city) throws IOException, InterruptedException {
        String encoded = URLEncoder.encode(city, StandardCharsets.UTF_8);
        String url = "https://geocoding-api.open-meteo.com/v1/search?name=" + encoded + "&count=1&language=en&format=json";

        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(url))
                .timeout(java.time.Duration.ofSeconds(15))
                .GET()
                .build();

        HttpResponse<String> response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());
        String json = response.body();

        if (!json.contains("\"results\"")) return null;

        String firstObject = extractFirstResultObject(json);
        if (firstObject.isEmpty()) return null;

        String name = extractString(firstObject, "name");
        String country = extractString(firstObject, "country");
        double latitude = extractDouble(firstObject, "latitude");
        double longitude = extractDouble(firstObject, "longitude");
        String timezone = extractString(firstObject, "timezone");

        if (name == null || timezone == null) return null;

        return new GeoLocation(name, country, latitude, longitude, timezone);
    }

    private List<String> geocodeSuggestions(String city) throws IOException, InterruptedException {
        String encoded = URLEncoder.encode(city, StandardCharsets.UTF_8);
        String url = "https://geocoding-api.open-meteo.com/v1/search?name=" + encoded + "&count=6&language=en&format=json";

        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(url))
                .timeout(java.time.Duration.ofSeconds(12))
                .GET()
                .build();

        HttpResponse<String> response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());
        String json = response.body();

        List<String> result = new ArrayList<>();
        if (!json.contains("\"results\"")) return result;

        String array = extractArrayRaw(json, "results");
        if (array.isEmpty()) return result;

        List<String> objects = splitTopLevelObjects(array);
        for (String obj : objects) {
            String name = extractString(obj, "name");
            String country = extractString(obj, "country");
            String admin1 = extractString(obj, "admin1");

            if (name != null) {
                String text = name;
                if (admin1 != null && !admin1.isBlank()) text += " | " + admin1;
                if (country != null && !country.isBlank()) text += " | " + country;
                result.add(text);
            }
        }

        return result;
    }

    private WeatherResponse fetchWeather(GeoLocation loc) throws IOException, InterruptedException {
        String url =
                "https://api.open-meteo.com/v1/forecast" +
                        "?latitude=" + loc.latitude +
                        "&longitude=" + loc.longitude +
                        "&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,weather_code,surface_pressure,wind_speed_10m,visibility" +
                        "&hourly=temperature_2m,weather_code" +
                        "&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset" +
                        "&forecast_days=5" +
                        "&timezone=" + URLEncoder.encode(loc.timezone, StandardCharsets.UTF_8);

        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(url))
                .timeout(java.time.Duration.ofSeconds(15))
                .GET()
                .build();

        HttpResponse<String> response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());
        String json = response.body();

        WeatherResponse w = new WeatherResponse();
        w.cityDisplay = loc.name + (loc.country != null ? ", " + loc.country : "");
        w.originalCityName = loc.name;

        w.temperatureC = extractDoubleFromObject(json, "current", "temperature_2m");
        w.humidity = (int) extractDoubleFromObject(json, "current", "relative_humidity_2m");
        w.feelsLikeC = extractDoubleFromObject(json, "current", "apparent_temperature");
        w.weatherCode = (int) extractDoubleFromObject(json, "current", "weather_code");
        w.pressure = extractDoubleFromObject(json, "current", "surface_pressure");
        w.wind = extractDoubleFromObject(json, "current", "wind_speed_10m");
        w.visibilityKm = extractDoubleFromObject(json, "current", "visibility") / 1000.0;

        w.conditionText = weatherText(w.weatherCode);
        w.icon = weatherIcon(w.weatherCode);

        List<String> dailyTimes = extractStringArrayFromObject(json, "daily", "time");
        List<Double> dailyMax = extractNumberArrayFromObject(json, "daily", "temperature_2m_max");
        List<Double> dailyMin = extractNumberArrayFromObject(json, "daily", "temperature_2m_min");
        List<Double> dailyCodes = extractNumberArrayFromObject(json, "daily", "weather_code");
        List<String> sunrises = extractStringArrayFromObject(json, "daily", "sunrise");
        List<String> sunsets = extractStringArrayFromObject(json, "daily", "sunset");

        if (!sunrises.isEmpty()) w.sunrise = shortTime(sunrises.get(0));
        if (!sunsets.isEmpty()) w.sunset = shortTime(sunsets.get(0));

        w.forecast = new ArrayList<>();
        for (int i = 0; i < Math.min(5, dailyTimes.size()); i++) {
            ForecastDay day = new ForecastDay();
            day.day = shortDay(dailyTimes.get(i));
            int code = dailyCodes.get(i).intValue();
            day.condition = weatherText(code);
            day.icon = weatherIcon(code);
            day.maxC = dailyMax.get(i);
            day.minC = dailyMin.get(i);
            w.forecast.add(day);
        }

        List<String> hourlyTimes = extractStringArrayFromObject(json, "hourly", "time");
        List<Double> hourlyTemps = extractNumberArrayFromObject(json, "hourly", "temperature_2m");

        w.hourly = new ArrayList<>();
        for (int i = 0; i < Math.min(10, hourlyTemps.size()); i++) {
            HourData h = new HourData();
            h.hour = shortHour(hourlyTimes.get(i));
            h.tempC = hourlyTemps.get(i);
            w.hourly.add(h);
        }

        return w;
    }

